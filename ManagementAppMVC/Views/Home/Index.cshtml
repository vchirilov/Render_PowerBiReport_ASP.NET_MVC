@{
    ViewData["Title"] = "Home Page";
}
<div class="text-center">
    <h1 class="display-4">Welcome to Management Application</h1>
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="ViewReport" asp-controller="Home" method="get">
                <div class="mb-3">
                    <label for="companySelect" class="form-label">Select the client</label>
                    <select class="form-select" id="countryId" name="country" required>
                        <option value="">-- Choose company--</option>
                        <option value="C001">Alpha Learning Tech</option>
                        <option value="C002">Beta Corporate Academy</option>
                        <option value="C003">Gamma Skills Hub</option>
                        <option value="C004">Delta Training Solutions</option>
                        <option value="C005">Omega Edu Services</option>
                        <option value="C006">Nova Learning Group</option>
                        <option value="C007">Sigma Corporate Learning</option>
                        <option value="C008">Vertex Knowledge</option>
                        <option value="C009">Apex Training Co</option>
                        <option value="C010">Quantum Learning Ltd</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">View Report</button>
            </form>
        </div>
    </div>
</div>