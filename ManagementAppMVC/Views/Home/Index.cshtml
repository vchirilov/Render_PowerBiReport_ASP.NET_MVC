@{
    ViewData["Title"] = "Home Page";
}
<div class="text-center">
    <h1 class="display-4">Welcome to Management Application</h1>
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="ViewReport" asp-controller="Home" method="get">
                <div class="mb-3">
                    <label for="companySelect" class="form-label">Select the client</label>
                    <select class="form-select" id="countryId" name="country" required>
                        <option value="">-- Choose company--</option>
                        <option value="Alpha Learning Tech">Alpha Learning Tech</option>
                        <option value="Beta Corporate Academy">Beta Corporate Academy</option>
                        <option value="Gamma Skills Hub">Gamma Skills Hub</option>
                        <option value="Delta Training Solutions">Delta Training Solutions</option>
                        <option value="Omega Edu Services">Omega Edu Services</option>
                        <option value="Nova Learning Group">Nova Learning Group</option>
                        <option value="Sigma Corporate Learning">Sigma Corporate Learning</option>
                        <option value="Vertex Knowledge">Vertex Knowledge</option>
                        <option value="Apex Training Co">Apex Training Co</option>
                        <option value="Quantum Learning Ltd">Quantum Learning Ltd</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">View Report</button>
            </form>
        </div>
    </div>
</div>